{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayTrace",
  "mainBinaryName": "daytrace",
  "version": "0.1.0",
  "identifier": "io.github.ammarqaisar11a55.DayTrace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Privacy-first desktop activity tracking",
    "longDescription": "DayTrace records which applications you use and how your time is spent, without timers. All data stays on your computer.",
    "copyright": "Copyright 2026 Muhammad Ammar Qaisar",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyRjU1NTM5MDM2NTZENTEKUldSUmJXVURPVlgxd2k0bXZnQmxCdnFyNXArM3ZKYnRkMGRTdzhjTkRZSnllamFCZklzTm1TZXcK",
      "endpoints": [
        "https://github.com/ammarqaisar11a55/DayTrace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
